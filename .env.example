# MADE NEW web app (browser). Copy to .env.local and fill in.
# Only VITE_PUBLIC_* variables reach the browser bundle. Never put a secret here:
# anything in this file is visible to every visitor.
# Leave Supabase or Shopify blank to run in labelled demo mode with sample data.

# Base URL of the MADE NEW API server (server/). Leave blank in demo mode.
VITE_PUBLIC_API_BASE_URL=

# Supabase project URL and the anon (public) key. Never the service_role key.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Shopify store domain and a Storefront API public access token.
VITE_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Where privacy requests (data export, account deletion) are sent.
VITE_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example

# development | staging | production
VITE_PUBLIC_APP_ENV=development
