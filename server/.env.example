# MADE NEW API server. Copy to server/.env (never commit it) or set these in
# your host's secret manager. Every value below is a placeholder.

NODE_ENV=development
PORT=8787
PUBLIC_SITE_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; keep it out of the browser, logs and source control.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for projects still on the legacy HS256 JWT secret. Otherwise JWKS is used.
SUPABASE_JWT_SECRET=

# Shopify (custom app with the Admin API scopes listed in docs/DEPLOYMENT.md)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# The app's API secret key, used to verify webhook HMAC signatures.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-01
# Sales channel to publish new products to (the Headless channel your Storefront token belongs to).
SHOPIFY_PUBLICATION_ID=

# Print on demand: printful | printify | none
POD_PROVIDER=none
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Malware scanning of uploads (clamd). Without it, uploads stay "pending" and cannot be approved.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Random string (32+ chars) used to hash Shopify customer ids so no customer PII is stored.
CUSTOMER_REF_SALT=
# Require MFA (aal2) for reviewer, admin and finance accounts.
REQUIRE_STAFF_MFA=true
